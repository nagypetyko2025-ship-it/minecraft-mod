{
  "type": "minecraft:sequence",
  "sequence": [
    "minecraft:bedrock_floor",
    {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:above_preliminary_surface"
      },
      "then_run": {
        "type": "minecraft:sequence",
        "sequence": [
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:stone_depth",
              "add_surface_depth": false,
              "offset": 0,
              "secondary_depth_range": 0,
              "surface_type": "floor"
            },
            "then_run": {
              "type": "minecraft:sequence",
              "sequence": [
                {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:biome",
                    "biome_is": [
                      "endrealms:sculk_peaks"
                    ]
                  },
                  "then_run": {
                    "type": "minecraft:sequence",
                    "sequence": [
                      {
                        "type": "minecraft:condition",
                        "if_true": {
                          "type": "minecraft:noise_threshold",
                          "noise": "minecraft:surface",
                          "min_threshold": 0.0,
                          "max_threshold": 10.0
                        },
                        "then_run": {
                          "type": "minecraft:block",
                          "result_state": "minecraft:sculk"
                        }
                      },
                      {
                        "type": "minecraft:block",
                        "result_state": "endrealms:sculk_stone"
                      }
                    ]
                  }
                },
                {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:biome",
                    "biome_is": [
                      "endrealms:withered_woods"
                    ]
                  },
                  "then_run": {
                    "type": "minecraft:sequence",
                    "sequence": [
                      {
                        "type": "minecraft:condition",
                        "if_true": {
                          "type": "minecraft:noise_threshold",
                          "noise": "minecraft:surface",
                          "min_threshold": -0.55,
                          "max_threshold": 10.0
                        },
                        "then_run": {
                          "type": "minecraft:block",
                          "result_state": "minecraft:sculk"
                        }
                      },
                      {
                        "type": "minecraft:block",
                        "result_state": "endrealms:sculk_soil"
                      }
                    ]
                  }
                },
                {
                  "type": "minecraft:sequence",
                  "sequence": [
                    {
                      "type": "minecraft:condition",
                      "if_true": {
                        "type": "minecraft:noise_threshold",
                        "noise": "minecraft:surface",
                        "min_threshold": -0.2,
                        "max_threshold": 10.0
                      },
                      "then_run": {
                        "type": "minecraft:block",
                        "result_state": "minecraft:sculk"
                      }
                    },
                    {
                      "type": "minecraft:condition",
                      "if_true": {
                        "type": "minecraft:noise_threshold",
                        "noise": "minecraft:surface",
                        "min_threshold": -10.0,
                        "max_threshold": -0.65
                      },
                      "then_run": {
                        "type": "minecraft:block",
                        "result_state": "minecraft:soul_soil"
                      }
                    },
                    {
                      "type": "minecraft:block",
                      "result_state": "endrealms:sculk_soil"
                    }
                  ]
                }
              ]
            }
          },
          {
            "type": "minecraft:condition",
            "if_true": {
              "type": "minecraft:stone_depth",
              "add_surface_depth": true,
              "offset": 0,
              "secondary_depth_range": 0,
              "surface_type": "floor"
            },
            "then_run": {
              "type": "minecraft:sequence",
              "sequence": [
                {
                  "type": "minecraft:condition",
                  "if_true": {
                    "type": "minecraft:biome",
                    "biome_is": [
                      "endrealms:sculk_peaks"
                    ]
                  },
                  "then_run": {
                    "type": "minecraft:block",
                    "result_state": "endrealms:sculk_stone"
                  }
                },
                {
                  "type": "minecraft:block",
                  "result_state": "endrealms:sculk_soil"
                }
              ]
            }
          }
        ]
      }
    },
    {
      "type": "minecraft:condition",
      "if_true": {
        "type": "minecraft:noise_threshold",
        "noise": "minecraft:calcite",
        "min_threshold": -0.03,
        "max_threshold": 0.03
      },
      "then_run": {
        "type": "minecraft:block",
        "result_state": "minecraft:deepslate"
      }
    }
  ]
}
